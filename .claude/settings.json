{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/popup-and-focus.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/lint-fix.sh \"$FILE_PATH\""
          }
        ]
      }
    ]
  },
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "bash ./.claude/hooks/inject-local.sh"
        }
      ]
    }
  ],
  "enabledMcpjsonServers": ["seed-design"]
}
